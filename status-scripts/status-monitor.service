[Unit]
Description=Raspberry Pi Status Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/python3 -u __REPO_ROOT__/status-scripts/status_monitor.py
Restart=always
RestartSec=10
StandardOutput=append:__REPO_ROOT__/status_monitor.log
StandardError=append:__REPO_ROOT__/status_monitor.log

[Install]
WantedBy=multi-user.target
