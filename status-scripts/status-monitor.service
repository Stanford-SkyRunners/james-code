[Unit]
Description=Raspberry Pi Status Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=james
WorkingDirectory=/home/james/skyrunners
ExecStart=/usr/bin/python3 -u /home/james/skyrunners/status-scripts/status_monitor.py
Restart=always
RestartSec=10
StandardOutput=append:/home/james/skyrunners/status_monitor.log
StandardError=append:/home/james/skyrunners/status_monitor.log

[Install]
WantedBy=multi-user.target
